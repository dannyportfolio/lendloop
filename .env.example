# ==============================================================================
# LendLoop Environment Configuration Template
# NOTE: Never commit real secrets or production credentials to source control.
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Authentication
# ------------------------------------------------------------------------------
# Public publishable key for Clerk browser components
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key
# Private secret key for Clerk backend API verification
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key
# The JWT issuer domain configured in Clerk JWT Templates for Convex (e.g., https://verb-noun-00.clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=https://sample-domain.clerk.accounts.dev

# ------------------------------------------------------------------------------
# 2. Convex Backend
# ------------------------------------------------------------------------------
# Public URL for the Convex deployment client WebSocket connection
NEXT_PUBLIC_CONVEX_URL=https://sample-project-000.convex.cloud
# Convex deployment identifier
CONVEX_DEPLOYMENT=dev:sample-project-000
# Convex HTTP actions site URL (used for webhooks and write-back callbacks)
CONVEX_SITE_URL=https://sample-project-000.convex.site

# ------------------------------------------------------------------------------
# 3. Webhook & Automation Security (Convex <-> n8n)
# ------------------------------------------------------------------------------
# Shared 256-bit secret used to generate HMAC SHA-256 signatures for webhook dispatches
CONVEX_N8N_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Destination webhook URL exposed by the local or cloud n8n Workflow A receiver
CONVEX_N8N_WEBHOOK_URL=http://localhost:5678/webhook/borrow-request
# Bearer secret required by Convex HTTP actions to authenticate inbound write-backs from n8n
N8N_CONVEX_WRITEBACK_SECRET=secret_bearer_token_for_n8n_writeback_verification

# ------------------------------------------------------------------------------
# 4. n8n Engine Configuration (Docker Compose)
# ------------------------------------------------------------------------------
# Base URL for accessing the n8n automation dashboard
N8N_BASE_URL=http://localhost:5678
# High-entropy key used by n8n to encrypt stored integration credentials
N8N_ENCRYPTION_KEY=super_secure_n8n_encryption_key_placeholder

# ------------------------------------------------------------------------------
# 5. Application URLs
# ------------------------------------------------------------------------------
# Base canonical URL of the LendLoop application
APP_URL=http://localhost:3000
